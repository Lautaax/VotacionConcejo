rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic Auth Helpers
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lautaroj@hcd.com' ||
        (exists(/databases/$(database)/documents/concejales/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/concejales/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Public Reads
    match /configuracion/sesion { allow read: if true; allow write: if isAdmin(); }
    match /expedientes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /concejales/{id} { allow read: if true; allow write: if isAdmin() || request.auth.uid == id; }
    match /votos/{id} { allow read: if true; allow create: if isSignedIn(); }
    match /autorizados/{id} { allow read: if true; allow write: if isAdmin(); }
    
    // Fallback deny to prevent accidental leaks
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
